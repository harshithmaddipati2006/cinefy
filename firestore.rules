rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    match /movies/{movieId} {
      allow read, write: if true;
    }
    match /theatres/{theatreId} {
      allow read, write: if true;
    }
    match /events/{eventId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read: if true;
    }
  }
}

