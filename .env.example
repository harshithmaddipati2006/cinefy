# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGO_URI: MongoDB Atlas connection string (optional - app falls back to high-performance in-memory state engine if not provided)
MONGO_URI="mongodb+srv://user:pass@cluster.mongodb.net/cinefy"

# JWT_SECRET: Secret key for signing JWT tokens
JWT_SECRET="cinefy_super_secret_jwt_key_2026"

# ADMIN_PASSWORD: Dedicated password for the admin account
ADMIN_PASSWORD="Admin@CineFy2026"

# RAZORPAY_KEY_ID: Razorpay Key ID (rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID="rzp_test_your_key_id"

# RAZORPAY_KEY_SECRET: Razorpay Secret Key (Kept strictly on server side)
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# RAZORPAY_WEBHOOK_SECRET: Razorpay Webhook Secret for server-to-server validation
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

